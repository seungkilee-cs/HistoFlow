# Copy to .env and adjust for your environment.
#
# These are throwaway LOCAL-DEV defaults. The Docker stack falls back to them
# when the variables are unset, and the backend reads the same names when run
# outside Docker (./gradlew bootRun). Set real values in any shared or
# production environment — never reuse these.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=histoflow
POSTGRES_USER=histoflow
POSTGRES_PASSWORD=histoflow123

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
# Root credentials for the MinIO server; the backend and ML services
# authenticate against MinIO with these.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
